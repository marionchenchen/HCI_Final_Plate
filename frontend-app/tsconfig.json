{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // here2
    "target": "es2017",
    "lib": ["dom", "es2017"],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
